        "# WP16 targeted [0,3,m] orbit-family scan\\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from google.colab import drive\\n",
        "drive.mount('/content/drive')\\n",
        "import os,subprocess,sys\\n",
        "ROOT='/content/drive/MyDrive/WP16_CUTOFF_ESCALATION'\\n",
        "REPO='/content/navier-stokes-bridge-audit'\\n",
        "PRIOR=ROOT+'/wp16_phase_cutoff_escalation_results.json'\\n",
        "CURRENT=ROOT+'/wp16_phase_cutoff_escalation_N10_N11.json'\\n",
        "OUT=ROOT+'/wp16_targeted_orbit_family_scan_results.json'\\n",
        "os.chdir('/content'); subprocess.run(['rm','-rf',REPO],check=True)\\n",
        "URL='https://'+'github.com/'+'reggaesharkk/'+'navier-stokes-bridge-audit.git'\\n",
        "subprocess.run(['git','clone',URL,REPO],cwd='/content',check=True)\\n",
        "os.chdir(REPO)\\n",
        "print('HEAD',subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip())\\n",
        "cmd=[sys.executable,'src/wp16_targeted_orbit_family_scan.py','--prior-json',PRIOR,'--current-json',CURRENT,'--grid','48','--epsilon','0.1','--m-min','3','--m-max','10','--output',OUT]\\n",
        "print(' '.join(cmd)); subprocess.run(cmd,cwd=REPO,check=True)\\n",
        "print('Saved:',OUT)\\n"
      ]
    }
  ]
}\n