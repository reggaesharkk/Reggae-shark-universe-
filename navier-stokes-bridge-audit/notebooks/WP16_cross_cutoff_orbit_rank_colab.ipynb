        "# WP16 cross-cutoff orbit/rank audit\\n",
        "LRSC-style persistence and singular-spectrum test across N9→N10 and N10→N11.\\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from google.colab import drive\\n",
        "drive.mount('/content/drive')\\n",
        "import os, subprocess, sys\\n",
        "REPO='/content/navier-stokes-bridge-audit'\\n",
        "ROOT='/content/drive/MyDrive/WP16_CUTOFF_ESCALATION'\\n",
        "PRIOR=ROOT+'/wp16_phase_cutoff_escalation_results.json'\\n",
        "CURRENT=ROOT+'/wp16_phase_cutoff_escalation_N10_N11.json'\\n",
        "OUT=ROOT+'/wp16_cross_cutoff_orbit_rank_results.json'\\n",
        "assert os.path.exists(PRIOR), f'Missing prior N8/N9 JSON: {PRIOR}'\\n",
        "assert os.path.exists(CURRENT), f'Missing N10/N11 JSON: {CURRENT}'\\n",
        "os.chdir('/content')\\n",
        "subprocess.run(['rm','-rf',REPO],check=True)\\n",
        "URL='https://'+'github.com/'+'reggaesharkk/'+'navier-stokes-bridge-audit.git'\\n",
        "subprocess.run(['git','clone',URL,REPO],cwd='/content',check=True)\\n",
        "os.chdir(REPO)\\n",
        "print('HEAD',subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip())\\n",
        "cmd=[sys.executable,'src/wp16_cross_cutoff_orbit_rank_gate.py','--prior-json',PRIOR,'--current-json',CURRENT,'--grid','48','--epsilon','0.1','--output',OUT]\\n",
        "print(' '.join(cmd))\\n",
        "subprocess.run(cmd,cwd=REPO,check=True)\\n",
        "print('Saved:',OUT)\\n"
      ]
    }
  ]
}\n